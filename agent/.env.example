LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-120b

# 備援引擎（可留空 = 停用）。免費金鎖：https://aistudio.google.com
LLM_API_KEY_GEMINI=

# 語音辨識（預設沿用 LLM_API_KEY 與 Groq 端點，通常不用改）
# STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=

AGENT_HOST=127.0.0.1
AGENT_PORT=8000
LLM_CONNECT_TIMEOUT=2
LLM_SHORT_TIMEOUT=8
LLM_MAX_RETRIES=2
